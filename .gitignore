*.gguf
models/
evidence/
experiments/local_model/runtime/
*.sqlite
*.sqlite3
*.db

# Python and editor artifacts.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
