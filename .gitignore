# Documentation and local reports stay outside Git by owner decision.
**/*.md
!/README.md
**/*.pdf
**/*.docx
**/*.odt
**/*.rtf
docs/
reports/
.agent/feature-list.json

# Local configuration and secrets.
.env
.env.*
config
config.*
# Исходник приложения с именем config не относится к локальным настройкам.
!/src/api_agent/policy/config.py
*.key
*.pem

# Local model weights, runtime output, and test evidence.
*.gguf
models/
experiments/
evidence/
*.sqlite
*.sqlite3
*.db
*.sqlite3.lock
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.before-migration-*

# Python and editor artifacts.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/

# Tests are retained locally as a separately archived verification bundle.
/tests/
